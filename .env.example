# Selam CPA Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# API Configuration
# ===========================================
VITE_API_URL=/api

# ===========================================
# Business Contact Information
# ===========================================
# Display format for phone number on website
VITE_PUBLIC_PHONE_DISPLAY=(###) ###-####
# Server-side phone configuration (same values)
PUBLIC_PHONE_DISPLAY=(###) ###-####
PUBLIC_PHONE_E164=+1##########

# ===========================================
# External Service URLs
# ===========================================
# Your Calendly booking URL
VITE_CALENDLY_URL=https://calendly.com/YOUR-CALENDLY
CALENDLY_URL=https://calendly.com/YOUR-CALENDLY

# AI Agent/Chatbot URL
VITE_AGENT_PUBLIC_URL=https://YOUR-AGENT-APP-URL
AGENT_PUBLIC_URL=https://YOUR-AGENT-APP-URL

# ===========================================
# Social Media & SEO
# ===========================================
# Path to your social sharing image (1200x630px recommended)
VITE_SOCIAL_IMAGE=/img/social-share-1200x630.png

# ===========================================
# Optional Configurations
# ===========================================
# Google Analytics tracking ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email service configuration
# SENDGRID_API_KEY=your_sendgrid_api_key

# Business forms and file sharing
# INTAKE_FORM_URL=https://docs.google.com/forms/your-form-url
# SECURE_UPLOAD_URL=https://your-secure-upload-url

# Frontend domain for SEO
# FRONTEND_ORIGIN=https://yourdomain.com

# ===========================================
# Facebook Page Posting (AI-draft -> approval -> publish)
# ===========================================
# Page ID and a Page Access Token with pages_manage_posts scope.
# How to get: https://developers.facebook.com/docs/pages/access-tokens
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_API_VERSION=v19.0

# Used to build absolute approve/reject links in the email. Falls back to
# FRONTEND_ORIGIN if unset.
# PUBLIC_SITE_URL=https://yourdomain.com

# Where approval emails are sent and who they are sent from.
# Both required (in addition to SENDGRID_API_KEY) for email delivery -
# without them, approval links are printed to the server log instead.
# SOCIAL_APPROVAL_EMAIL=approver@yourdomain.com
# SOCIAL_APPROVAL_FROM=no-reply@yourdomain.com

# ===========================================
# Development Notes
# ===========================================
# 1. Variables starting with VITE_ are available in the frontend
# 2. Other variables are server-side only
# 3. Restart your development server after changing environment variables
# 4. Never commit sensitive data to version control